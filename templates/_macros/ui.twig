{% macro icon(name) %}
  {% if name == 'facebook' %}
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4V10c0-.6.4-1 1-1z"/></svg>
  {% elseif name == 'twitter' %}
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.6 7.3c.5-.3.9-.8 1.1-1.3-.5.3-1 .5-1.6.6A2.5 2.5 0 0 0 14.7 9c0 .2 0 .4.1.6-2.1-.1-4-1.1-5.3-2.7-.2.4-.3.8-.3 1.2 0 .9.5 1.6 1.1 2.1-.4 0-.8-.1-1.2-.3v.1c0 1.2.9 2.2 2 2.5-.2.1-.4.1-.7.1-.2 0-.3 0-.5-.1.3 1 1.2 1.7 2.3 1.7A5 5 0 0 1 6 16.6a7.1 7.1 0 0 0 3.8 1.1c4.6 0 7.1-3.8 7.1-7.1v-.3c.5-.4.9-.8 1.2-1.3-.4.2-.9.4-1.5.4z"/></svg>
  {% elseif name == 'copy' %}
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 7V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h3zm2 0h5a2 2 0 0 1 2 2v5h2V5H10v2zM5 9v10h9V9H5z"/></svg>
  {% elseif name == 'arrow' %}
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13 5l7 7-7 7v-4H4v-6h9V5z"/></svg>
  {% elseif name == 'up' %}
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 5l8 8h-5v6H9v-6H4l8-8z"/></svg>
  {% endif %}
{% endmacro %}

{% macro excerpt(text, length = 160) %}
  {% set clean = text|striptags|replace({'\n': ' ', '\r': ' ', '&nbsp;': ' '})|trim %}
  {% if clean|length > length %}
    {{ clean|slice(0, length - 1)|trim }}…
  {% else %}
    {{ clean }}
  {% endif %}
{% endmacro %}

{% macro assetImage(asset, alt, class, width, height, lazy = true) %}
  {% if asset %}
    {% set transform = { width: width, height: height, mode: 'crop' } %}
    <img
      src="{{ asset.getUrl(transform) }}"
      alt="{{ alt|e }}"
      class="{{ class }}"
      width="{{ width }}"
      height="{{ height }}"
      {% if lazy %}loading="lazy" decoding="async"{% else %}fetchpriority="high" decoding="async"{% endif %}
    >
  {% endif %}
{% endmacro %}
