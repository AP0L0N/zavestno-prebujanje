{% extends '_layouts/site-content' %}
{% import '_macros/ui' as ui %}

{% block content %}
    {% set image = mainAuthor.authorInfo.profilePicture.one() ?? null %}

    {% include '_partials/breadcrumbs' with { crumbs: [{ title: 'O meni', url: url('about') }] } %}

    <article class="article">
        <div class="article-body">
            <p class="section-kicker">Astrologinja</p>
            <h1>{{ mainAuthor.authorInfo.authorName ?? 'Špela Plemelj' }}</h1>
            <p class="meta">{{ mainAuthor.authorInfo.authorTitle ?? 'Astrologinja' }}</p>

            <div class="author-panel" style="margin: 1.2rem 0 1.6rem; box-shadow: none;">
                {% if image %}
                    {{ ui.assetImage(image, mainAuthor.authorInfo.authorName, '', 400, 400, false) }}
                {% else %}
                    <img src="/assets/images/spela.jpg" alt="Špela Plemelj" width="160" height="160">
                {% endif %}
                <div class="entry-content">
                    <p>{{ mainAuthor.authorInfo.description|nl2br }}</p>
                </div>
            </div>

            <div class="hero-actions">
                {% if mainAuthor.authorInfo.facebook %}
                    <a class="btn btn-outline" href="{{ mainAuthor.authorInfo.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
                {% endif %}
                {% if mainAuthor.authorInfo.twitter %}
                    <a class="btn btn-outline" href="{{ mainAuthor.authorInfo.twitter }}" target="_blank" rel="noopener noreferrer">X</a>
                {% endif %}
                <a class="btn btn-gold" href="{{ url('contact') }}">Kontakt</a>
            </div>
        </div>
    </article>
{% endblock %}
