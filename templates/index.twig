{% extends '_layouts/site-content' %}

{% block content %}
    {% set sectionHandle = entry is defined and entry ? entry.section.handle : 'naslovnaStran' %}

    {% if sectionHandle == 'naslovnaStran' %}
        {% include '_pages/home' %}

    {% elseif sectionHandle == 'prispevki' %}
        {% include '_fields/blogInfo' %}

    {% elseif sectionHandle in ['horoskop', 'letniHoroskop'] %}
        {% include '_fields/horoskopInfo' %}

    {% else %}
        {% include '_fields/pageInfo' %}
    {% endif %}
{% endblock %}
