<footer class="site-footer">
    <div class="container footer-grid">
        <div>
            <a class="footer-brand" href="{{ siteUrl }}">
                <img src="/assets/images/logo.png" width="42" height="42" alt="">
                <strong>Zavestno prebujanje</strong>
            </a>
            {% if globalInfo is defined and globalInfo.pageInfo %}
                <div>{{ globalInfo.pageInfo.besedilo|striptags|slice(0, 280) }}{% if globalInfo.pageInfo.besedilo|striptags|length > 280 %}…{% endif %}</div>
            {% endif %}
        </div>

        <div>
            <h3>Povezave</h3>
            <ul class="footer-links">
                <li><a href="{{ siteUrl }}">Domov</a></li>
                <li><a href="{{ url('horoskop') }}">Horoskop</a></li>
                <li><a href="{{ url('prispevki') }}">Članki</a></li>
                <li><a href="{{ url('about') }}">O meni</a></li>
                <li><a href="{{ url('contact') }}">Kontakt</a></li>
                <li><a href="{{ url('feed.xml') }}">RSS</a></li>
            </ul>
        </div>

        <div>
            <h3>Kontakt</h3>
            <ul class="footer-links">
                {% if mainContact is defined and mainContact.contactInfo and mainContact.contactInfo.email %}
                    <li><a href="mailto:{{ mainContact.contactInfo.email }}">{{ mainContact.contactInfo.email }}</a></li>
                {% endif %}
                {% if mainContact is defined and mainContact.contactInfo and mainContact.contactInfo.phoneNumber %}
                    <li><a href="tel:{{ mainContact.contactInfo.phoneNumber|replace({' ': ''}) }}">{{ mainContact.contactInfo.phoneNumber }}</a></li>
                {% endif %}
                {% if mainAuthor is defined and mainAuthor.authorInfo and mainAuthor.authorInfo.facebook %}
                    <li><a href="{{ mainAuthor.authorInfo.facebook }}" rel="noopener noreferrer" target="_blank">Facebook</a></li>
                {% endif %}
            </ul>
        </div>
    </div>

    <div class="container footer-copy">
        <span>© {{ now|date('Y') }} Zavestno prebujanje. Vse pravice pridržane.</span>
        <a href="https://zavestnoprebujanje.si">zavestnoprebujanje.si</a>
    </div>
</footer>
