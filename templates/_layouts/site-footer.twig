<!-- Footer -->
<footer class="page-footer font-small blue pt-4">

    <!-- Footer Links -->
    <div class="container text-center text-md-left">

        <!-- Grid row -->
        <div class="row">

            <!-- Grid column -->
            <div class="col-md-8 mt-md-0 mt-3">

                <!-- Content -->
                <h5 class="text-uppercase">{{ globalInfo.pageInfo.naslov }}</h5>
                <p>{{ globalInfo.pageInfo.besedilo }}</p>

            </div>
            <!-- Grid column -->

            <hr class="clearfix w-100 d-md-none pb-3">

            <!-- Grid column -->
            <div class="col-md-1 mb-md-0 mb-3">
            </div>
            <!-- Grid column -->

            <!-- Grid column -->
            <div class="col-md-3 mb-md-0 mb-3">

                <!-- Links -->
                <h5 class="text-uppercase">Povezave</h5>

                <ul class="list-unstyled">

                    {% for node in craft.navigation.nodes().handle('leftNav').level(1).all() %}
                        <li class="mb-2">

                            <a href="{{ node.url }}" class="text-info">{{ node.title }}</a>

                        </li>
                    {% endfor %}

                    {% for node in craft.navigation.nodes().handle('rightNav').level(1).all() %}
                        <li class="mb-2">

                            <a href="{{ node.url }}" class="text-info">{{ node.title }}</a>

                        </li>
                    {% endfor %}

                </ul>

            </div>
            <!-- Grid column -->

        </div>
        <!-- Grid row -->

    </div>
    <!-- Footer Links -->

    <!-- Copyright -->
    <div class="footer-copyright text-center py-3">© {{ now|date("Y") }} Vse pravice pridržane:
        <a href="http://zavestnoprebujanje.si" class="text-info"> zavestnoprebujanje.si</a>
    </div>
    <!-- Copyright -->

</footer>
<!-- Footer -->
