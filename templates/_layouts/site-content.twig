<!DOCTYPE html>
<html lang="sl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% include '_layouts/site-seo' %}

    {% set env = getenv('ENVIRONMENT') %}
    {% if env == 'dev' %}
        {% set revision = random() %}
    {% else %}
        {% set revision = "2.0.0" %}
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link href="{{ '/assets/css/site.css?rev=' ~ revision }}" rel="stylesheet">

    {% include '_layouts/jsonld' %}
    <link rel="manifest" href="/site.webmanifest">
</head>
<body id="top">
    {% set currentEntry = entry is defined ? entry : null %}
    {% set sectionHandle = currentEntry ? currentEntry.section.handle : '' %}
    {% set isHome = sectionHandle == 'naslovnaStran' %}
    {% set isFull = isHome or sectionHandle == '' %}

    <a class="skip-link" href="#content">Preskoči na vsebino</a>

    {% include '_layouts/site-header' %}

    <main id="content">
        {% if not isFull %}
            <div class="container">
                <div class="layout">
                    <div class="layout-main">
        {% endif %}

        {% block content %}{{ content is defined ? content }}{% endblock %}

        {% if not isFull %}
                    </div>
                    <aside class="layout-sidebar" aria-label="Stranski stolpec">
                        {% include '_layouts/site-sidebar' %}
                    </aside>
                </div>
            </div>
        {% endif %}
    </main>

    {% include '_layouts/site-footer' %}
    {% include '_layouts/site-modals' %}

    <a href="#top" class="to-top" data-to-top aria-label="Na vrh strani">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 5l8 8h-5v6H9v-6H4l8-8z"/></svg>
    </a>

    <script src="{{ '/assets/js/site.js?rev=' ~ revision }}" defer></script>
</body>
</html>
