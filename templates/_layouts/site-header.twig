{% set currentEntry = entry is defined ? entry : null %}
{% set currentUri = craft.app.request.pathInfo %}

<header class="site-header" data-header>
    <div class="container header-inner">
        <a class="brand" href="{{ siteUrl }}" aria-label="Zavestno prebujanje — domov">
            <img src="/assets/images/logo.png" width="48" height="48" alt="">
            <span class="brand-text">
                <span class="brand-name">Zavestno prebujanje</span>
                <span class="brand-tag">Astrologija in rast</span>
            </span>
        </a>

        <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Odpri meni">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="site-nav" id="site-nav" data-nav aria-label="Glavna navigacija">
            <ul>
                <li><a href="{{ siteUrl }}">Domov</a></li>
                <li><a href="{{ url('horoskop') }}">Horoskop</a></li>
                <li><a href="{{ url('prispevki') }}">Članki</a></li>
                <li>
                    <a class="{{ currentUri == 'about' ? 'is-active' }}" href="{{ url('about') }}">O meni</a>
                </li>
            </ul>
        </nav>
    </div>
</header>
