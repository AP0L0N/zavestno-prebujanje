{%- header "Content-Type: application/xml; charset=UTF-8" -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% set pages = craft.entries()
    .section(['naslovnaStran', 'seznamHoroskopov', 'seznamPrispevkov', 'oMeni', 'kontakt', 'prispevki', 'horoskop', 'letniHoroskop', 'staticneStrani'])
    .status('live')
    .limit(5000)
    .all() %}
{% for page in pages %}
    {% if page.url %}
    <url>
        <loc>{{ page.url|replace({'http://': 'https://'}) }}</loc>
        <lastmod>{{ page.dateUpdated|date('Y-m-d') }}</lastmod>
        {% if page.section.handle == 'naslovnaStran' %}
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
        {% elseif page.section.handle in ['seznamHoroskopov', 'horoskop'] %}
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
        {% elseif page.section.handle == 'seznamPrispevkov' %}
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
        {% else %}
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
        {% endif %}
    </url>
    {% endif %}
{% endfor %}
</urlset>
