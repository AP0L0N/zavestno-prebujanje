{% import '_macros/ui' as ui %}
{% set page = entry %}

{% if page and page.pageInfo %}
    {% set image = page.pageInfo.image.one() ?? null %}
    <article class="article">
        {% if image %}
            <div class="article-media">
                {{ ui.assetImage(image, 'Slika: ' ~ page.pageInfo.naslov, '', 1200, 675, false) }}
            </div>
        {% endif %}
        <div class="article-body">
            <h1>{{ page.pageInfo.naslov }}</h1>
            <div class="entry-content">
                {{ page.pageInfo.besedilo|raw }}
            </div>
        </div>
    </article>
{% endif %}
