{% import '_macros/ui' as ui %}
{% if mainAuthor is defined and mainAuthor.authorInfo %}
{% set image = mainAuthor.authorInfo.profilePicture.one() ?? null %}

<aside class="widget author-widget">
    {% if image %}
        {{ ui.assetImage(image, 'Špela Plemelj', '', 224, 224) }}
    {% else %}
        <img src="/assets/images/spela.jpg" alt="Špela Plemelj" width="112" height="112">
    {% endif %}
    <h2>{{ mainAuthor.authorInfo.authorName ?? 'Špela Plemelj' }}</h2>
    <p class="role">{{ mainAuthor.authorInfo.authorTitle ?? 'Astrologinja' }}</p>
    {% if mainAuthor.authorInfo.description %}
        <p>{{ mainAuthor.authorInfo.description|striptags|slice(0, 220) }}{% if mainAuthor.authorInfo.description|striptags|length > 220 %}…{% endif %}</p>
    {% endif %}
    <a class="btn btn-outline" href="{{ url('about') }}">Več o meni</a>
</aside>
{% endif %}
