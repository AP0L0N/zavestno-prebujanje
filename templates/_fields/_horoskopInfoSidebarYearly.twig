{% if horoskop and horoskop.horoskopInfo %}
    <aside class="widget">
        <p class="section-kicker">Letni horoskop</p>
        <h2>{{ horoskop.title }}</h2>
        {% if horoskop.horoskopInfo.opis %}
            <p>{{ horoskop.horoskopInfo.opis }}</p>
        {% endif %}
        <a class="btn btn-outline" href="{{ horoskop.url }}">Preberite letni horoskop</a>
    </aside>
{% endif %}
