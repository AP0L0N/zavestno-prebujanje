{% import '_macros/ui' as ui %}
{% set zodiacSigns = [
  { id: 'oven', name: 'Oven', field: 'opisOven', image: 'h-oven.png', dates: '21. 3. – 19. 4.' },
  { id: 'bik', name: 'Bik', field: 'opisBik', image: 'h-bik.png', dates: '20. 4. – 20. 5.' },
  { id: 'dvojcka', name: 'Dvojčka', field: 'opisDvojcka', image: 'h-dvojcka.png', dates: '21. 5. – 20. 6.' },
  { id: 'rak', name: 'Rak', field: 'opisRak', image: 'h-rak.png', dates: '21. 6. – 22. 7.' },
  { id: 'lev', name: 'Lev', field: 'opisLev', image: 'h-lev.png', dates: '23. 7. – 22. 8.' },
  { id: 'devica', name: 'Devica', field: 'opisDevica', image: 'h-devica.png', dates: '23. 8. – 22. 9.' },
  { id: 'tehtnica', name: 'Tehtnica', field: 'opisTehtnica', image: 'h-tehtnica.png', dates: '23. 9. – 22. 10.' },
  { id: 'skorpijon', name: 'Škorpijon', field: 'opisSkorpijon', image: 'h-skorpijon.png', dates: '23. 10. – 21. 11.' },
  { id: 'strelec', name: 'Strelec', field: 'opisStrelec', image: 'h-strelec.png', dates: '22. 11. – 21. 12.' },
  { id: 'kozorog', name: 'Kozorog', field: 'opisKozorog', image: 'h-kozorog.png', dates: '22. 12. – 19. 1.' },
  { id: 'vodnar', name: 'Vodnar', field: 'opisVodnar', image: 'h-vodnar.png', dates: '20. 1. – 18. 2.' },
  { id: 'ribi', name: 'Ribi', field: 'opisRibi', image: 'h-ribi.png', dates: '19. 2. – 20. 3.' }
] %}

{% if horoskop and horoskop.horoskopInfo %}
    <article class="article" itemscope itemtype="https://schema.org/Article">
        <div class="article-body">
            {% include '_partials/breadcrumbs' with {
                crumbs: [
                    { title: 'Horoskop', url: url('horoskop') },
                    { title: horoskop.title, url: horoskop.url }
                ]
            } %}

            <p class="section-kicker">
                {% if horoskop.section.handle == 'letniHoroskop' %}Letni horoskop{% else %}Tedenski horoskop{% endif %}
            </p>
            <h1 class="article-title" itemprop="headline">{{ horoskop.title }}</h1>

            <div class="meta">
                <span itemprop="author">{{ mainAuthor.authorInfo.authorName ?? 'Špela Plemelj' }}</span>
                <time datetime="{{ horoskop.postDate|date('c') }}" itemprop="datePublished">{{ horoskop.postDate|date('j. n. Y') }}</time>
            </div>

            {% if horoskop.horoskopInfo.opis %}
                <p class="lede">{{ horoskop.horoskopInfo.opis }}</p>
            {% endif %}

            <nav class="zodiac-nav" aria-label="Znamenja">
                {% for sign in zodiacSigns %}
                    <a href="#{{ sign.id }}">
                        <img src="/assets/images/{{ sign.image }}" alt="" width="36" height="36">
                        {{ sign.name }}
                    </a>
                {% endfor %}
            </nav>

            <div class="entry-content" itemprop="articleBody">
                {% for sign in zodiacSigns %}
                    {% set body = attribute(horoskop.horoskopInfo, sign.field) %}
                    <section class="zodiac-entry" id="{{ sign.id }}">
                        <img src="/assets/images/{{ sign.image }}" alt="Znamenje {{ sign.name }}" width="88" height="88">
                        <div>
                            <h2>{{ sign.name }}</h2>
                            <p class="zodiac-dates">{{ sign.dates }}</p>
                            {{ body|nl2br }}
                        </div>
                    </section>
                {% endfor %}
            </div>

            {% include '_partials/share' with { shareUrl: horoskop.url, shareTitle: horoskop.title } %}
        </div>
    </article>
{% endif %}
