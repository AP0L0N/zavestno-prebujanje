{% import '_macros/ui' as ui %}

{% if blog and blog.blogInfo %}
    {% set image = blog.blogInfo.image.one() ?? null %}
    <li class="sidebar-post">
        <a href="{{ blog.url }}">
            {% if image %}
                {{ ui.assetImage(image, '', '', 128, 128) }}
            {% endif %}
        </a>
        <div>
            <h3><a href="{{ blog.url }}">{{ blog.blogInfo.blogTitle }}</a></h3>
            <p class="meta"><time datetime="{{ blog.postDate|date('c') }}">{{ blog.postDate|date('j. n. Y') }}</time></p>
        </div>
    </li>
{% endif %}
