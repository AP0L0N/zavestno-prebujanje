{% if horoskop and horoskop.horoskopInfo %}
    <aside class="widget">
        <p class="section-kicker">Tedenski horoskop</p>
        <h2>{{ horoskop.title }}</h2>
        {% if horoskop.horoskopInfo.opis %}
            <p>{{ horoskop.horoskopInfo.opis }}</p>
        {% endif %}
        <a class="btn btn-teal" href="{{ horoskop.url }}">Preberite horoskop</a>
    </aside>
{% endif %}
