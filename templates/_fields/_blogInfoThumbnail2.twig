{% import '_macros/ui' as ui %}

{% if blog and blog.blogInfo %}
    {% set image = blog.blogInfo.image.one() ?? null %}
    <article class="post-card">
        <a href="{{ blog.url }}">
            <div class="post-card-media">
                {% if image %}
                    {{ ui.assetImage(image, 'Slika: ' ~ blog.blogInfo.blogTitle, '', 720, 450) }}
                {% endif %}
            </div>
            <div class="post-card-body">
                <div class="meta">
                    <time datetime="{{ blog.postDate|date('c') }}">{{ blog.postDate|date('j. n. Y') }}</time>
                </div>
                <h3>{{ blog.blogInfo.blogTitle }}</h3>
                <p>{{ ui.excerpt(blog.blogInfo.text, 120) }}</p>
            </div>
        </a>
    </article>
{% endif %}
