{% import '_macros/ui' as ui %}

{% if blog and blog.blogInfo %}
    {% set image = blog.blogInfo.image.one() ?? null %}
    <article class="article" itemscope itemtype="https://schema.org/Article">
        {% if image %}
            <div class="article-media">
                {{ ui.assetImage(image, 'Slika: ' ~ blog.blogInfo.blogTitle, '', 1200, 675, false) }}
            </div>
        {% endif %}

        <div class="article-body">
            {% include '_partials/breadcrumbs' with {
                crumbs: [
                    { title: 'Članki', url: url('prispevki') },
                    { title: blog.blogInfo.blogTitle, url: blog.url }
                ]
            } %}

            {% set tags = blog.blogInfo.tags.all() %}
            {% if tags|length %}
                <div class="tags">
                    {% for tag in tags %}
                        <span class="tag">{{ tag.title }}</span>
                    {% endfor %}
                </div>
            {% endif %}

            <h1 class="article-title" itemprop="headline">{{ blog.blogInfo.blogTitle }}</h1>

            <div class="meta">
                <span itemprop="author">{{ mainAuthor.authorInfo.authorName ?? 'Špela Plemelj' }}</span>
                <time datetime="{{ blog.postDate|date('c') }}" itemprop="datePublished">{{ blog.postDate|date('j. n. Y') }}</time>
            </div>

            <div class="entry-content" itemprop="articleBody">
                {{ blog.blogInfo.text|raw }}
            </div>

            {% include '_partials/share' with { shareUrl: blog.url, shareTitle: blog.blogInfo.blogTitle } %}
        </div>
    </article>
{% endif %}
