{% extends '_layouts/site-content' %}

{% block content %}
    {% include '_partials/breadcrumbs' with { crumbs: [{ title: 'Članki', url: url('prispevki') }] } %}

    <header class="page-hero">
        <p class="section-kicker">Zapisi</p>
        <h1>Članki</h1>
        <p>Astrološki zapisi o gibanju planetov, retrogradnih obdobjih in zavestnem prebujanju.</p>
    </header>

    {% paginate craft.entries().section('prispevki').orderBy('postDate desc').limit(9) as pageInfo, pageEntries %}

    <div class="card-grid">
        {% for blog in pageEntries %}
            {% include '_fields/_blogInfoThumbnail2' %}
        {% else %}
            <p class="empty-state">Člankov trenutno ni.</p>
        {% endfor %}
    </div>

    {% include '_partials/pagination' %}
{% endblock %}
