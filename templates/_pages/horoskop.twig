{% extends '_layouts/site-content' %}

{% block content %}
    {% include '_partials/breadcrumbs' with { crumbs: [{ title: 'Horoskop', url: url('horoskop') }] } %}

    <header class="page-hero">
        <p class="section-kicker">Astrologija</p>
        <h1>Horoskop</h1>
        <p>Tedenski in letni horoskop astrologinje Špele Plemelj za vsa znamenja.</p>
    </header>

    {% paginate craft.entries().section('horoskop').orderBy('postDate desc').limit(10) as pageInfo, pageEntries %}

    <h2 class="section-kicker" style="margin-bottom: 1rem;">Tedenski horoskop</h2>

    {% for horoskop in pageEntries %}
        {% include '_fields/_horoskopInfoThumbnail' %}
    {% else %}
        <p class="empty-state">Horoskopi bodo kmalu na voljo.</p>
    {% endfor %}

    {% include '_partials/pagination' %}

    {% set yearly = craft.entries().section('letniHoroskop').orderBy('postDate desc').limit(6).all() %}
    {% if yearly|length %}
        <h2 class="section-kicker" style="margin: 2rem 0 1rem;">Letni horoskop</h2>
        {% for horoskop in yearly %}
            {% include '_fields/_horoskopInfoThumbnail' %}
        {% endfor %}
    {% endif %}
{% endblock %}
