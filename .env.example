# The environment Craft is currently running in ('dev', 'staging', 'production', etc.)
ENVIRONMENT="dev"

# The secure key Craft will use for hashing and encrypting data
# Generate one with: php -r "echo bin2hex(random_bytes(16));"
SECURITY_KEY=""

# The database driver that will be used ('mysql' or 'pgsql')
DB_DRIVER="mysql"

# DDEV database host is 'db'. Local/native installs usually use 'localhost'.
DB_SERVER="db"

# DDEV default credentials are db / db / db
DB_USER="db"
DB_PASSWORD="db"
DB_DATABASE="db"

# The database schema that will be used (PostgreSQL only)
DB_SCHEMA="public"

# The prefix that should be added to generated table names
DB_TABLE_PREFIX=""

# DDEV MySQL port inside the web container is 3306
DB_PORT="3306"

# Public site URL used in templates and generated links.
# DDEV also injects DDEV_PRIMARY_URL; this overrides it when set.
PRIMARY_SITE_URL="https://zavestno-prebujanje.ddev.site"
